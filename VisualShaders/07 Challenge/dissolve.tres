void fragment() {
	vec4 n_out18p0;
// Texture2D:18
	n_out18p0 = texture(TEXTURE, UV);
	float n_out18p4 = n_out18p0.a;


// Input:3
	float n_out3p0 = TIME;


// FloatFunc:12
