code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D tex_frg_2;



void fragment() {
// ColorConstant:11
	vec4 n_out11p0 = vec4(0.086275, 0.243137, 1.000000, 1.000000);


// ColorConstant:10
	vec4 n_out10p0 = vec4(0.000000, 0.971707, 0.971707, 1.000000);


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// Input:16
	float n_out16p0 = TIME;


// FloatFunc:26
	float n_out26p0 = cos(n_out16p0);


// FloatOp:32
	float n_in32p1 = 0.50000;
	float n_out32p0 = n_out26p0 * n_in32p1;


// FloatFunc:31
	float n_out31p0 = sin(n_out16p0);


// FloatOp:34
	float n_in34p1 = 0.20000;
	float n_out34p0 = n_out31p0 * n_in34p1;


// VectorCompose:25
	vec2 n_out25p0 = vec2(n_out32p0, n_out34p0);


// VectorOp:29
	vec2 n_out29p0 = vec2(n_out2p0.xy) + n_out25p0;


// Mix:9
