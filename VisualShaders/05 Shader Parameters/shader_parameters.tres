[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 MainColor : source_color = vec4(0.086275, 0.243137, 1.000000, 1.000000);
uniform vec4 HighlightColor : source_color = vec4(0.000000, 0.971707, 0.971707, 1.000000);
uniform sampler2D tex_frg_2;
uniform float PulseIntensity : hint_range(0.0, 1.0) = 0.5;



void fragment() {
// ColorParameter:11
	vec4 n_out11p0 = MainColor;


// ColorParameter:10
	vec4 n_out10p0 = HighlightColor;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// Input:16
	float n_out16p0 = TIME;


// FloatFunc:26
	float n_out26p0 = cos(n_out16p0);


// FloatParameter:35
	float n_out35p0 = PulseIntensity;


// FloatOp:32
	float n_out32p0 = n_out26p0 * n_out35p0;


// VectorOp:29
	vec2 n_out29p0 = vec2(n_out2p0.xy) + vec2(n_out32p0);


// Mix:9
	vec3 n_out9p0 = mix(vec3(n_out11p0.xyz), vec3(n_out10p0.xyz), vec3(n_out29p0, 0.0));


// FloatOp:14
	float n_in14p1 = 0.50000;
	float n_out14p0 = max(n_out2p0.x, n_in14p1);


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(TEXTURE, UV);
	float n_out3p4 = n_out3p0.a;


// FloatOp:13
	float n_out13p0 = n_out14p0 * n_out3p4;


// Output:0
	COLOR.rgb = n_out9p0;
	COLOR.a = n_out13p0;


}
