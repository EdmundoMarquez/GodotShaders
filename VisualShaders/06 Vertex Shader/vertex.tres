code = "shader_type canvas_item;
render_mode blend_mix;

uniform float Speed : hint_range(0.0, 10.0) = 5.0;
uniform float Radius : hint_range(0.0, 0.0) = 50.0;



void vertex() {
// Input:12
	float n_out12p0 = TIME;


// FloatParameter:17
	float n_out17p0 = Speed;


// FloatOp:16
	float n_out16p0 = n_out12p0 * n_out17p0;


// FloatFunc:11
	float n_out11p0 = cos(n_out16p0);


// FloatParameter:7
	float n_out7p0 = Radius;


// FloatOp:6
	float n_out6p0 = n_out11p0 * n_out7p0;


// Input:2
	vec2 n_out2p0 = VERTEX;
	float n_out2p1 = n_out2p0.r;
	float n_out2p2 = n_out2p0.g;


// FloatOp:5
	float n_out5p0 = n_out6p0 + n_out2p1;


// FloatFunc:14
	float n_out14p0 = sin(n_out16p0);


// FloatOp:15
	float n_out15p0 = n_out7p0 * n_out14p0;


// FloatOp:13
	float n_out13p0 = n_out15p0 + n_out2p2;


// VectorCompose:3
	vec2 n_out3p0 = vec2(n_out5p0, n_out13p0);


// Output:0
	VERTEX = n_out3p0;


}
"
